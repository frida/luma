# Upstream revisions the Windows and Linux builds are pinned to.
#
# Read by LumaGtk/scripts/windows/bootstrap.ps1 and loaded into the
# workflow environment by .github/workflows/build.yml, so a bump here
# reaches CI and a local checkout at once. Cache keys are derived from
# these values, so changing one invalidates the matching cache.
#
# Format is KEY=value, one per line; no quoting, no expansion.

FRIDA_CORE_REF=b66a485f7c8f12407c51d5994907eca549d27066
RADARE2_REF=b015691bbd1e5a78f502630c3adc4de7b3246999
SWIFTY_PHARO_REF=465f5fa1c55eb5b6ec6e281217325f7d6e9cbce3

# The upstream QEMU the Windows build compiles from source, against
# the same vcpkg GLib the app links.
QEMU_VERSION=11.1.0

# The qemu-<build> release published by .github/workflows/qemu.yml,
# which macOS downloads; the checksums are the ones its release notes
# print for each zip.
QEMU_BUILD=11.1.0-luma.1
QEMU_MACOS_ARM64_SHA256=2397011de95317cf534a17628141f34f888035581d55a989cef27a04788fba9f
QEMU_MACOS_X86_64_SHA256=98fa5b8a2102363e5ca2d0071fce9596559675f3fddba6ca15803feb6e9b85b5
